APP_ENV=development
APP_PORT=8501
API_PORT=5000

POSTGRES_DB=edurag
POSTGRES_USER=edurag
# Dev-only placeholder. The shared host uses a generated password kept in its
# own .env, which is gitignored. Do not reuse this value anywhere reachable.
POSTGRES_PASSWORD=edurag_dev_password
POSTGRES_PORT=5432

CHROMA_PORT=8000

# Which host address the API, Streamlit and Postgres are published on.
# Loopback by default, so a local checkout is never exposed to your network.
# The shared host sets this to its Tailscale address, which puts the services
# on the mesh without also putting them on the local Wi-Fi.
# ChromaDB and Ollama are always loopback-only; the API reaches them over the
# compose network by service name.
PAEDIA_BIND_ADDR=127.0.0.1


OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
# CPU-safe default: works on any machine, including a grader's with no GPU.
# The scripts/start_stack.ps1 wrapper overwrites this automatically based on
# detected VRAM. If running "manual compose" (README section 6.2) on a GPU
# with >= 12 GB VRAM, change this to qwen3:14b by hand for the full model.
DEFAULT_OLLAMA_MODEL=llama3.2

# Optional fallback for private local testing only.
# Do not commit real secrets.
OPENAI_API_KEY=

# Streamlit direct-run settings. Docker Compose overrides PAEDIA_API_URL to
# http://api:5000 inside the demo network.
PAEDIA_API_URL=http://localhost:5000
PAEDIA_USE_FIXTURES=false

# Browser origin permitted to call the API directly (CORS). On the shared host
# this is the Tailscale address the team opens, not localhost.
PAEDIA_ALLOWED_ORIGIN=http://localhost:8501

# Generation settings, read by src/document_processor/rag_pipeline.py.
# OLLAMA_THINK stays false: qwen3 spends its whole token budget reasoning and
# returns an empty answer otherwise.
OLLAMA_NUM_PREDICT=220
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_THINK=false
TOP_K=5
PROMPT_STRATEGY=evidence_cited

# Demo account passwords. The defaults in db.py are the old published ones and
# are fine for a checkout only you can reach. Any shared instance must set
# these to something the repo does not contain.
PAEDIA_DEMO_ADMIN_PASSWORD=
PAEDIA_DEMO_LECTURER_PASSWORD=
PAEDIA_DEMO_STUDENT_PASSWORD=
